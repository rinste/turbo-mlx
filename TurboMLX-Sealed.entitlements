<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The sealed build's entitlements: the sandbox with no temporary exception. Models live in the
     container unless the user picks a folder (user-selected, kept as a security-scoped bookmark);
     no Sparkle, so no mach-lookup exceptions either. The embedded engine has its own two
     (Engine/turbo-engine.entitlements): the sandbox, inherited from the app. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
